    direction TB
    E0[activity ledger]:::contract
    E1[[setters\nsetPlatformFee\nsetAuthorFee\n...]]:::shield
    E2[platformFeeBps]:::contract
  end

  %% Reputation loop
  M0 --> E0
  M1 -->|mint Rep| R[RepToken]:::contract
  R --> M

  %% Proposal lifecycle
  M2 -->|target=Economy\ncalldata| G1
  M3 --> G1
  G1 -->|pass| G2
  G1 -->|fail| G3

  %% Timelock execution
  G2 --> G4 --> T1 --> T2 --> G5 --> T3 -->|only| E1
  E1 -->|apply| E2

  %% Feedback loop
  E2 -->|new rules| E0 -->|earn/spend| M1

  %% Cross-diagram pointer
  E0 -. "Projects" .- P[Project Contracts]:::state