# --- .aiaccess file for WeRule Proposal Features ---


# Include the core proposal creation and detail features.
# This is where we'll add the UI for new proposal types.
!lib/src/features/create_proposal/
!lib/src/features/proposal_detail/

# Include the proposals tab, as it's the entry point for creating a proposal.
!lib/src/features/dao_detail/tabs/proposals_tab.dart
!lib/src/features/dao_detail/widgets/proposal_list_item.dart

# Include the essential providers that manage the state for these features.
!lib/src/providers/create_proposal_provider.dart
!lib/src/providers/treasury_provider.dart
!lib/src/providers/proposal_detail_provider.dart
!lib/src/providers/auth_provider.dart # Needed for signer address.

# Include the core services for blockchain interaction and data encoding.
# These are critical for implementing the new transfer types.
!lib/src/services/blockchain_service.dart
!lib/src/services/calldata_service.dart
!lib/src/services/firestore_service.dart # To see how proposals are stored/retrieved.
!lib/src/services/governor_abi.dart
!lib/src/services/treasury_service.dart
!lib/src/services/erc20_gov_abi.dart

# Include the core data models that define what a proposal, DAO, and network are.
!lib/src/models/proposal.dart
!lib/src/models/org.dart
!lib/src/models/network.dart

# Include the proposal status helper for display logic.
!lib/src/utils/proposal_status_helper.dart